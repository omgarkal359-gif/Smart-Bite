<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'SGU Smart-Bite' %></title>
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      background-color: #0F172A;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #F8FAFC;
    }
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }
    td {
      padding: 0;
    }
    img {
      border: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #1E293B;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .content-padding {
      padding: 32px 24px;
    }
    @media screen and (max-width: 600px) {
      .email-container {
        width: 100% !important;
        border-radius: 0 !important;
      }
      .content-padding {
        padding: 24px 16px !important;
      }
    }
  </style>
</head>
<body>
  <div style="background-color: #0F172A; padding: 40px 10px; min-height: 100vh;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" class="email-container" width="100%" cellpadding="0" cellspacing="0" border="0">
            <!-- Header -->
            <tr>
              <td>
                <%- include('header', { logo: logo, companyName: companyName }) %>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td class="content-padding">
                <%- body %>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td>
                <%- include('footer', { companyName: companyName, supportEmail: supportEmail, currentYear: currentYear }) %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
