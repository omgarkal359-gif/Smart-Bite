<div style="font-family: Arial, sans-serif; max-width: 520px; margin: 0 auto; padding: 28px 24px; background: #0B132B; color: #FFFFFF; border-radius: 16px;">
  <h2 style="color: #38BDF8; text-align: center; margin-top: 0;">New Contact Form Message</h2>
  <div style="background: #1C2541; padding: 20px; border-radius: 12px; margin: 20px 0;">
    <p style="margin: 0 0 8px 0; font-size: 13px; color: #94A3B8;"><strong>Name:</strong> <%= typeof senderName !== 'undefined' ? senderName : 'Guest' %></p>
    <p style="margin: 0 0 8px 0; font-size: 13px; color: #94A3B8;"><strong>Email:</strong> <%= typeof senderEmail !== 'undefined' ? senderEmail : 'N/A' %></p>
    <p style="margin: 0 0 8px 0; font-size: 13px; color: #94A3B8;"><strong>Subject:</strong> <%= typeof subject !== 'undefined' ? subject : 'General Inquiry' %></p>
    <hr style="border: 0; border-top: 1px solid #334155; margin: 12px 0;">
    <p style="margin: 0; font-size: 14px; color: #F8FAFC; white-space: pre-wrap;"><%= typeof message !== 'undefined' ? message : '' %></p>
  </div>
</div>
