<div style="font-family: Arial, sans-serif; max-width: 480px; margin: 0 auto; padding: 28px 24px; background: #0B132B; color: #FFFFFF; border-radius: 16px;">
  <h2 style="color: #E4002B; text-align: center; margin-top: 0;">Verify Your Email Address</h2>
  <p style="font-size: 14px; text-align: center; color: #CBD5E1;">Hello<%= typeof userName !== 'undefined' && userName ? ' ' + userName : '' %>,</p>
  <p style="font-size: 14px; text-align: center; color: #CBD5E1;">Please confirm your email address to complete your registration with SGU Smart-Bite.</p>
  <div style="text-align: center; margin: 24px 0;">
    <a href="<%= typeof verificationLink !== 'undefined' ? verificationLink : '#' %>" style="background: #E4002B; color: #FFFFFF; padding: 14px 28px; border-radius: 12px; text-decoration: none; font-weight: bold; display: inline-block;">Verify Email Address</a>
  </div>
  <p style="font-size: 12px; color: #94A3B8; text-align: center;">If you did not create an account, please disregard this email.</p>
</div>
