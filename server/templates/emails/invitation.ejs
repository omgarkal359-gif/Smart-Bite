<div style="font-family: Arial, sans-serif; max-width: 500px; margin: 0 auto; padding: 28px 24px; background: #0B132B; color: #FFFFFF; border-radius: 16px;">
  <h2 style="color: #E4002B; text-align: center; margin-top: 0;">You're Invited to Join SGU Smart-Bite!</h2>
  <p style="font-size: 14px; color: #CBD5E1;">Hello <%= typeof inviteeName !== 'undefined' ? inviteeName : 'Partner' %>,</p>
  <p style="font-size: 14px; color: #CBD5E1;">
    You have been invited to join the SGU Smart-Bite platform as a <strong><%= typeof role !== 'undefined' ? role : 'Vendor / Staff' %></strong> for <strong><%= typeof stallName !== 'undefined' ? stallName : 'SGU Food Court' %></strong>.
  </p>
  <div style="text-align: center; margin: 28px 0;">
    <a href="<%= typeof inviteLink !== 'undefined' ? inviteLink : '#' %>" style="background: #E4002B; color: #FFFFFF; padding: 14px 30px; border-radius: 12px; text-decoration: none; font-weight: bold; font-size: 15px; display: inline-block;">Accept Invitation</a>
  </div>
  <p style="font-size: 12px; color: #94A3B8; text-align: center;">This invitation link is valid for 48 hours.</p>
</div>
